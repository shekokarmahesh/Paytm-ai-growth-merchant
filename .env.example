# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Sarvam (all AI: LLM, STT, TTS) ---
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Business sender, with the whatsapp: prefix and no spaces, e.g. whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=
# How often to poll Twilio for new inbound messages (no webhook / no tunnel)
TWILIO_POLL_SECONDS=3

# --- Demo merchant phone ---
# Your phone with the whatsapp: prefix, e.g. whatsapp:+91XXXXXXXXXX
# For the demo, both merchants (kirana + electronics) map to this number.
DEMO_MERCHANT_WHATSAPP=

# --- Database (SQLite file, relative to repo root) ---
DATABASE_PATH=var/vyapar.db

# --- App ---
APP_PORT=8000
# Simulated "now" for the demo (ISO, Asia/Kolkata). Empty = real clock.
DEMO_NOW=2026-10-06T13:45:00+05:30
TIMEZONE=Asia/Kolkata
